{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile with role, subscription plan, and active license metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "USER"] },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "PENDING"] },
        "plan": { "type": "string", "enum": ["FREE", "BASIC", "PRO", "VIP", "ENTERPRISE"] },
        "activeLicenseKey": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "role"]
    },
    "admin": {
      "title": "Admin",
      "description": "Trusted administrative identity registry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email"]
    },
    "license": {
      "title": "License",
      "description": "FSL TRADER software access key and entitlement configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "key": { "type": "string", "maxLength": 64 },
        "plan": { "type": "string", "enum": ["FREE", "BASIC", "PRO", "VIP", "ENTERPRISE"] },
        "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "SUSPENDED", "REVOKED", "UNUSED"] },
        "maxDevices": { "type": "number" },
        "scanLimit": { "type": "number" },
        "activationsCount": { "type": "number" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["key", "plan", "status"]
    },
    "signal": {
      "title": "Signal",
      "description": "Market confluence trading signal generated by quantitative engine",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "symbol": { "type": "string", "maxLength": 32 },
        "market": { "type": "string", "maxLength": 32 },
        "timeframe": { "type": "string", "maxLength": 16 },
        "direction": { "type": "string", "enum": ["UP", "DOWN", "NO_TRADE"] },
        "confluenceScore": { "type": "number" },
        "setupQuality": { "type": "string", "enum": ["HIGH", "MODERATE", "LOW"] },
        "setupTitle": { "type": "string", "maxLength": 128 },
        "currentPrice": { "type": "number" },
        "explanation": { "type": "string", "maxLength": 2048 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "symbol", "direction", "confluenceScore"]
    },
    "auditLog": {
      "title": "AuditLog",
      "description": "Immutable security and trader activity audit event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 64 },
        "resource": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Individual user accounts and subscription status"
    },
    "/admins/{userId}": {
      "schema": "admin",
      "description": "Trusted administrative identity registry"
    },
    "/licenses/{licenseId}": {
      "schema": "license",
      "description": "Trading platform activation and license keys"
    },
    "/signals/{signalId}": {
      "schema": "signal",
      "description": "Quantitative market signals"
    },
    "/audit_logs/{logId}": {
      "schema": "auditLog",
      "description": "Immutable audit events"
    }
  }
}
